---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, postDate, postUrl, projectName, projects, sortedPosts, typeNames } from '../lib/blog';

const posts = sortedPosts(await getCollection('blog'));
---

<BaseLayout title="devBambu 기술 블로그">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> DEVELOPING IN PUBLIC</p>
      <h1 id="hero-title">만든 것보다<br /><em>선택한 이유를</em> 기록합니다.</h1>
      <p class="hero-description">기술적 결정, 문제 해결, 개선의 과정을 남기는 개발 기록입니다. 결론과 함께 그 결론에 도달한 이유를 적습니다.</p>
      <a class="text-link" href="#articles">글 살펴보기 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-aside" aria-hidden="true">
      <span class="aside-index">01 / NOTES</span>
      <span class="aside-symbol">{`{ }`}</span>
      <span class="aside-caption">Decisions<br />Problems<br />Improvements</span>
    </div>
  </section>

  <section class="section" id="articles" aria-labelledby="articles-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">WRITING</p>
        <h2 id="articles-title">최근 글</h2>
      </div>
      <span class="section-count">{String(posts.length).padStart(2, '0')} POSTS</span>
    </div>
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post, index) => (
          <a class="post-row" href={postUrl(post)}>
            <span class="post-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="post-main">
              <span class="post-meta">{projectName(post.data.project)} <span aria-hidden="true">/</span> {post.data.type ? typeNames[post.data.type] : '일반'}</span>
              <strong>{post.data.title}</strong>
            </span>
            <span class="post-date">{formatDate(postDate(post))}</span>
            <span class="post-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <span class="empty-icon" aria-hidden="true">✳</span>
        <p>첫 글을 준비하고 있어요.</p>
        <span>작성 중인 초안은 검토를 거쳐 이곳에 공개됩니다.</span>
      </div>
    )}
  </section>

  <section class="section projects-section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">PROJECTS</p>
        <h2 id="projects-title">프로젝트별 기록</h2>
      </div>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <a class="project-card" href={`/projects/${project.id}/`}>
          <span class="project-index">0{index + 1}</span>
          <strong>{project.name}</strong>
          <span class="project-bottom"><span>기록 보기</span><span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
