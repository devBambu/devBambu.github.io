---
import { getCollection } from 'astro:content';
import BlogListing from '../components/BlogListing.astro';
import { sortedPosts } from '../lib/blog';

const posts = sortedPosts(await getCollection('blog'));
---

<BlogListing title="글 목록" description="개발하면서 내린 결정과 해결한 문제를 기록합니다." posts={posts} current="all" />
