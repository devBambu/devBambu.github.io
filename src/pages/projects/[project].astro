---
import { getCollection } from 'astro:content';
import BlogListing from '../../components/BlogListing.astro';
import { projects, sortedPosts } from '../../lib/blog';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { project: project.id }, props: { project } }));
}

const { project } = Astro.props;
const posts = sortedPosts((await getCollection('blog')).filter((post) => post.data.project === project.id));
---

<BlogListing title={project.name} description={`${project.name} 프로젝트의 개발 기록입니다.`} posts={posts} current={project.id} />
