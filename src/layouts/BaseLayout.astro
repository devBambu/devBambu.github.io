---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '개발 과정에서 내린 선택과 해결 과정을 기록합니다.' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="devBambu 기술 블로그 글 목록">devBambu <small>기술 블로그</small></a>
        <nav aria-label="주요 메뉴">
          <a href="/">글 목록</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>© devBambu</span>
        <a href="https://github.com/devBambu" rel="me">GitHub</a>
      </footer>
    </div>
  </body>
</html>
